<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee"
         xmlns:xsi="http://w3.org"
         xsi:schemaLocation="https://jakarta.ee 
                             https://jakarta.ee/web-app_5_0.xsd"
         version="5.0">

    <!-- Nombre de la aplicación -->
    <display-name>MiAplicacionWeb</display-name>

    <!-- Parámetro de contexto global -->
    <context-param>
        <param-name>nombreParametro</param-name>
        <param-value>valorParametro</param-value>
    </context-param>


<servlet>
    <servlet-name>jersey</servlet-name>
    <servlet-class>
        org.glassfish.jersey.servlet.ServletContainer
    </servlet-class>

    <init-param>
        <param-name>jakarta.ws.rs.Application</param-name>
        <param-value>model.config.ApiConfig</param-value>
    </init-param>

    <load-on-startup>1</load-on-startup>
</servlet>

<servlet-mapping>
    <servlet-name>jersey</servlet-name>
    <url-pattern>/api/*</url-pattern>
</servlet-mapping>

    <!-- Definición de la página de inicio por defecto -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Configuración del tiempo de expiración de sesión (en minutos) -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>
