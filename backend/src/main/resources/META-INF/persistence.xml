<?xml version="1.0" encoding="UTF-8"?>

<persistence
    xmlns="https://jakarta.ee/xml/ns/persistence"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        https://jakarta.ee/xml/ns/persistence
        https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
    version="3.0">

    <persistence-unit name="miUP" transaction-type="RESOURCE_LOCAL">

        <provider>
            org.hibernate.jpa.HibernatePersistenceProvider
        </provider>
        
		<class>model.Actividad</class>
		<class>model.Agenda</class>
		<class>model.AsignacionEvaluacion</class>
		<class>model.AutorTrabajo</class>
		<class>model.Circular</class>
		<class>model.Congreso</class>
		<class>model.Cronograma</class>
		<class>model.DatosFactura</class>
		<class>model.DecisionTrabajo</class>
		<class>model.DisponibilidadEvaluadorEje</class>
		<class>model.EjeTematico</class>
		<class>model.EtapaCongreso</class>
		<class>model.Evaluacion</class>
		<class>model.Inscripcion</class>
		<class>model.ItemAgenda</class>
		<class>model.Noticia</class>
		<class>model.Notificacion</class>
		<class>model.PerfilEvaluador</class>
		<class>model.PlantillaEmail</class>
		<class>model.QR</class>
		<class>model.Rol</class>
		<class>model.Trabajo</class>
		<class>model.Usuario</class>
		

        <properties>

            <property
                name="jakarta.persistence.jdbc.driver"
                value="com.mysql.cj.jdbc.Driver"/>
			    
			<property
			    name="jakarta.persistence.jdbc.url"
			    value="jdbc:mysql://mysql.java.linti.unlp.edu.ar:3306/jyaa2026_bd7?useSSL=false&amp;serverTimezone=UTC"/>
			
			<property
			    name="jakarta.persistence.jdbc.user"
			    value="jyaa2026_usr7"/>
			
			<property
			    name="jakarta.persistence.jdbc.password"
			    value="jyaa2026_pwd7"/>

			<property name="hibernate.dialect"
			          value="org.hibernate.dialect.MySQLDialect"/>

			<property name="hibernate.format_sql"
          value="true"/>
          
            <property
                name="hibernate.hbm2ddl.auto"
                value="update"/>

            <property
                name="hibernate.show_sql"
                value="true"/>

        </properties>

    </persistence-unit>

</persistence>